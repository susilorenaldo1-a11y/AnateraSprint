{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/board", "destination": "/index.html" },
    { "source": "/calendar", "destination": "/index.html" },
    { "source": "/archive", "destination": "/index.html" }
  ]
}
